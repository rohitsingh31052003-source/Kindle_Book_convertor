{
  "schema_version": 1,
  "description": "M6.3 conversion-quality expectations over the M6.1 corpus. Each expectation is an authored claim about what good output looks like (structure, reading order, OCR routing, image handling, EPUB presentation). Classification is deliberately absent: it is derived from the corpus manifest at evaluation time. Refreshed only via `python -m tests.quality.regenerate_baseline --write` after human review of the diff.",
  "dimension_order": [
    "classification",
    "structure",
    "reading_order",
    "ocr",
    "images",
    "epub"
  ],
  "documents": {
